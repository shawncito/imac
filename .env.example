# Copia este archivo a .env y rellena los valores.
# NUNCA commitees .env (ya está en .gitignore).
# Nota: las vars VITE_* se embeben en el bundle del cliente → NO son secretas.

# El admin ahora usa Supabase Auth (email+password) — ya NO hay password en el bundle.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
